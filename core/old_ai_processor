# core/ai_processor.py
from openai import OpenAI
import json
from django.conf import settings
from transformers import pipeline

# Load once at startup
sentiment_analyzer = pipeline("sentiment-analysis", model="distilbert-base-uncased-finetuned-sst-2-english")

# Initialize OpenAI client
client = OpenAI(api_key=getattr(settings, 'OPENAI_API_KEY', ''))


def analyze_sentiment(message_text):
    """Basic sentiment analysis"""
    try:
        result = sentiment_analyzer(message_text[:512])
        return result[0]['label'], result[0]['score']
    except Exception as e:
        print(f"Sentiment analysis error: {e}")
        return 'NEUTRAL', 0.5


def extract_construction_intel(message_text):
    """
    Use AI to extract: trade, location, delays, and relevance
    Returns dict with extracted info
    """
    prompt = f"""Analyze this construction site message and extract:
1. Trade/discipline (Electrical, Plumbing, HVAC, Concrete, Framing, etc.)
2. Location on site (if mentioned)
3. Is this a delay? (yes/no)
4. If delay, what's the reason?
5. Key action items or status updates

Message: "{message_text}"

Respond ONLY with valid JSON:
{{
  "trade": "trade name or empty string",
  "location": "location or empty string", 
  "is_delay": true/false,
  "delay_reason": "reason or empty string",
  "summary": "one sentence summary"
}}"""

    try:
        response = client.chat.completions.create(
            model="gpt-4",
            messages=[{"role": "user", "content": prompt}],
            max_tokens=150,
            temperature=0.3
        )
        
        result_text = response.choices[0].message.content.strip()
        # Remove markdown code fences if present
        result_text = result_text.replace('```json', '').replace('```', '').strip()
        data = json.loads(result_text)
        
        # Ensure empty strings instead of None
        return {
            "trade": data.get('trade') or '',
            "location": data.get('location') or '',
            "is_delay": data.get('is_delay', False),
            "delay_reason": data.get('delay_reason') or '',
            "summary": data.get('summary') or message_text[:100]
        }
    
    except Exception as e:
        print(f"AI extraction error: {e}")
        # Return safe defaults instead of None
        return {
            "trade": '',
            "location": '',
            "is_delay": False,
            "delay_reason": '',
            "summary": message_text[:100]
        }


def transcribe_voice_note(audio_file_path):
    """Transcribe voice notes using Whisper API"""
    try:
        with open(audio_file_path, 'rb') as audio_file:
            response = client.audio.transcriptions.create(
                model="whisper-1",
                file=audio_file
            )
        return response.text
    except Exception as e:
        print(f"Transcription error: {e}")
        return ""


def describe_image(image_url_or_path):
    """Generate description of construction photo using GPT-4 Vision"""
    try:
        response = client.chat.completions.create(
            model="gpt-4-vision-preview",
            messages=[
                {
                    "role": "user",
                    "content": [
                        {
                            "type": "text",
                            "text": "Describe this construction site image. Identify: trade/work type, location if visible, quality/completion status, any issues."
                        },
                        {
                            "type": "image_url",
                            "image_url": {"url": image_url_or_path}
                        }
                    ]
                }
            ],
            max_tokens=200
        )
        return response.choices[0].message.content
    except Exception as e:
        print(f"Image description error: {e}")
        return "Photo uploaded"


def detect_weather_delay(message_text):
    """Quick check for weather-related delays"""
    weather_keywords = ['rain', 'weather', 'storm', 'snow', 'wind', 'flood', 'wet', 'delay']
    text_lower = message_text.lower()
    return any(keyword in text_lower for keyword in weather_keywords)


def suggest_related_documents(message_text, available_docs):
    """Use AI to suggest which docs from Drive are relevant to this message"""
    if not available_docs:
        return []
    
    doc_list = "\n".join([f"- {doc['name']} ({doc['type']})" for doc in available_docs[:20]])
    
    prompt = f"""Given this construction message:
"{message_text}"

Which of these documents are most relevant? List up to 3 document names:
{doc_list}

Respond with JSON array of document names: ["doc1.pdf", "doc2.xlsx"]"""

    try:
        response = client.chat.completions.create(
            model="gpt-4",
            messages=[{"role": "user", "content": prompt}],
            max_tokens=100,
            temperature=0.2
        )
        
        result_text = response.choices[0].message.content.strip()
        result_text = result_text.replace('```json', '').replace('```', '').strip()
        suggested_names = json.loads(result_text)
        
        # Return matching doc objects
        return [doc for doc in available_docs if doc['name'] in suggested_names]
    
    except Exception as e:
        print(f"Document suggestion error: {e}")
        return []


def generate_dashboard_summary(recent_messages, sheet_data):
    """Create executive summary of recent activity"""
    message_texts = "\n".join([f"- {msg['body']}" for msg in recent_messages[:10]])
    
    prompt = f"""Summarize the current construction project status based on:

Recent Messages:
{message_texts}

Sheet Data Summary: {len(sheet_data)} rows of bid/cost data

Provide a 2-3 sentence executive summary highlighting:
- Overall progress
- Any delays or issues
- Key metrics"""

    try:
        response = client.chat.completions.create(
            model="gpt-4",
            messages=[{"role": "user", "content": prompt}],
            max_tokens=150
        )
        return response.choices[0].message.content
    except Exception as e:
        print(f"Summary generation error: {e}")
        return "Recent activity tracked. Check details below."