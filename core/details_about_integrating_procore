python# core/procore_sync.py
import requests
from datetime import datetime, timedelta
from django.utils import timezone


class ProcoreAPI:
    """Procore API client"""
    
    BASE_URL = "https://api.procore.com/rest/v1.0"
    
    def __init__(self, access_token, company_id):
        self.access_token = access_token
        self.company_id = company_id
        self.headers = {
            'Authorization': f'Bearer {access_token}',
            'Content-Type': 'application/json'
        }
    
    def create_daily_log(self, project_id, message_data):
        """
        Create a daily log entry in Procore
        
        Args:
            project_id: Procore project ID
            message_data: Dict with {date, notes, weather, etc}
        """
        url = f"{self.BASE_URL}/projects/{project_id}/daily_logs"
        
        payload = {
            "daily_log": {
                "date": message_data.get('date', datetime.now().strftime('%Y-%m-%d')),
                "notes": message_data.get('notes', ''),
                "weather": message_data.get('weather', 'Clear'),
                "temperature": message_data.get('temperature', 70),
                "created_by": "GrowEasy Integration"
            }
        }
        
        try:
            response = requests.post(url, json=payload, headers=self.headers)
            response.raise_for_status()
            return response.json()
        except Exception as e:
            print(f"Error creating Procore daily log: {e}")
            return None
    
    def create_observation(self, project_id, observation_data):
        """
        Create an observation (like our alerts/delays)
        
        Args:
            project_id: Procore project ID
            observation_data: Dict with observation details
        """
        url = f"{self.BASE_URL}/projects/{project_id}/observations/items"
        
        payload = {
            "observation_item": {
                "title": observation_data.get('title', 'Delay Alert'),
                "description": observation_data.get('description', ''),
                "status": observation_data.get('status', 'open'),
                "type": observation_data.get('type', 'issue'),
                "location": observation_data.get('location', ''),
                "trade": observation_data.get('trade', ''),
                "created_by": "GrowEasy"
            }
        }
        
        try:
            response = requests.post(url, json=payload, headers=self.headers)
            response.raise_for_status()
            return response.json()
        except Exception as e:
            print(f"Error creating Procore observation: {e}")
            return None
    
    def upload_photo(self, project_id, photo_url, description=''):
        """
        Upload photo to Procore
        
        Args:
            project_id: Procore project ID
            photo_url: URL of photo from WhatsApp/Drive
            description: Photo description
        """
        url = f"{self.BASE_URL}/projects/{project_id}/images"
        
        # Download photo from WhatsApp
        photo_response = requests.get(photo_url)
        
        files = {
            'file': ('photo.jpg', photo_response.content, 'image/jpeg')
        }
        
        data = {
            'description': description,
            'source': 'GrowEasy'
        }
        
        try:
            response = requests.post(
                url, 
                files=files, 
                data=data,
                headers={'Authorization': f'Bearer {self.access_token}'}
            )
            response.raise_for_status()
            return response.json()
        except Exception as e:
            print(f"Error uploading photo to Procore: {e}")
            return None
    
    def get_projects(self):
        """Get list of all projects in Procore company"""
        url = f"{self.BASE_URL}/companies/{self.company_id}/projects"
        
        try:
            response = requests.get(url, headers=self.headers)
            response.raise_for_status()
            return response.json()
        except Exception as e:
            print(f"Error fetching Procore projects: {e}")
            return []


def sync_message_to_procore(message_id):
    """
    Sync a GrowEasy message to Procore daily log
    """
    from .models import Message, ProcoreIntegration
    
    try:
        message = Message.objects.get(id=message_id)
        
        # Check if project has Procore integration
        if not hasattr(message.project, 'procore'):
            return False
        
        procore_config = message.project.procore
        
        if not procore_config.is_active or not procore_config.sync_messages:
            return False
        
        # Initialize Procore API
        api = ProcoreAPI(
            access_token=procore_config.access_token,
            company_id=procore_config.company_id
        )
        
        # Create daily log entry
        log_data = {
            'date': message.created_at.strftime('%Y-%m-%d'),
            'notes': f"[{message.sender_name}] {message.body}\n\n"
                    f"Trade: {message.trade_detected or 'N/A'}\n"
                    f"Location: {message.location_detected or 'N/A'}\n"
                    f"Sentiment: {message.sentiment}\n"
                    f"Source: GrowEasy WhatsApp Integration",
            'weather': 'Rain' if message.is_delay and 'rain' in message.body.lower() else 'Clear'
        }
        
        result = api.create_daily_log(
            procore_config.procore_project_id,
            log_data
        )
        
        if result:
            print(f"✅ Synced message {message_id} to Procore")
            procore_config.last_synced = timezone.now()
            procore_config.save()
            return True
        
        return False
    
    except Exception as e:
        print(f"Error syncing message to Procore: {e}")
        return False


def sync_alert_to_procore(alert_id):
    """
    Sync a GrowEasy alert to Procore observation
    """
    from .models import Alert, ProcoreIntegration
    
    try:
        alert = Alert.objects.get(id=alert_id)
        
        if not hasattr(alert.project, 'procore'):
            return False
        
        procore_config = alert.project.procore
        
        if not procore_config.is_active or not procore_config.sync_delays:
            return False
        
        api = ProcoreAPI(
            access_token=procore_config.access_token,
            company_id=procore_config.company_id
        )
        
        # Create observation
        obs_data = {
            'title': alert.title,
            'description': alert.description,
            'status': 'open',
            'type': 'weather_delay' if alert.alert_type == 'WEATHER' else 'delay',
            'location': alert.related_message.location_detected if alert.related_message else '',
            'trade': alert.related_message.trade_detected if alert.related_message else ''
        }
        
        result = api.create_observation(
            procore_config.procore_project_id,
            obs_data
        )
        
        if result:
            print(f"✅ Synced alert {alert_id} to Procore observation")
            return True
        
        return False
    
    except Exception as e:
        print(f"Error syncing alert to Procore: {e}")
        return False

