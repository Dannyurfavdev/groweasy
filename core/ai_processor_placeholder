import re
from transformers import pipeline

# Load sentiment analyzer once at startup
try:
    sentiment_analyzer = pipeline("sentiment-analysis", model="distilbert-base-uncased-finetuned-sst-2-english")
except Exception as e:
    print(f"Warning: Could not load sentiment analyzer: {e}")
    sentiment_analyzer = None


def analyze_sentiment(message_text):
    """Basic sentiment analysis with construction-aware fallback"""
    
    # Construction-specific positive/negative keywords
    positive_keywords = [
        'complete', 'completed', 'done', 'finished', 'ready', 'passed', 
        'approved', 'good', 'great', 'perfect', 'success', 'excellent',
        'on schedule', 'ahead', 'progress', 'installed', 'delivered'
    ]
    
    negative_keywords = [
        'delay', 'delayed', 'problem', 'issue', 'rain', 'weather', 
        'behind', 'late', 'waiting', 'failed', 'reject', 'unsafe',
        'postpone', 'reschedule', 'cancel', 'shortage', 'missing'
    ]
    
    text_lower = message_text.lower()
    
    # Count keyword matches
    pos_count = sum(1 for word in positive_keywords if word in text_lower)
    neg_count = sum(1 for word in negative_keywords if word in text_lower)
    
    # Use transformers as secondary check if available
    transformer_sentiment = None
    transformer_score = 0.5
    
    if sentiment_analyzer:
        try:
            result = sentiment_analyzer(message_text[:512])
            transformer_sentiment = result[0]['label']
            transformer_score = result[0]['score']
        except Exception as e:
            print(f"Transformer sentiment error: {e}")
    
    # Decision logic: keyword matching takes priority for construction text
    if pos_count > neg_count:
        return 'POSITIVE', max(0.85, transformer_score if transformer_sentiment == 'POSITIVE' else 0.85)
    elif neg_count > pos_count:
        return 'NEGATIVE', max(0.85, transformer_score if transformer_sentiment == 'NEGATIVE' else 0.85)
    else:
        # No clear keywords - use transformer if available
        if transformer_sentiment:
            return transformer_sentiment, transformer_score
        else:
            return 'NEUTRAL', 0.70


def extract_construction_intel(message_text):
    """
    Extract construction info using keyword matching and patterns
    Returns dict with extracted info
    """
    text_lower = message_text.lower()
    
    # Trade detection with keywords
    trade_keywords = {
        'Electrical': ['electrical', 'electric', 'wiring', 'wire', 'power', 'voltage', 'circuit', 'breaker'],
        'Plumbing': ['plumbing', 'plumber', 'pipe', 'pipes', 'water', 'drain', 'sewer', 'fixture'],
        'HVAC': ['hvac', 'heating', 'cooling', 'air conditioning', 'ventilation', 'ac unit', 'furnace', 'duct'],
        'Concrete': ['concrete', 'pour', 'foundation', 'slab', 'cement', 'footing'],
        'Framing': ['framing', 'frame', 'lumber', 'wood', 'stud', 'joist', 'beam'],
        'Drywall': ['drywall', 'sheetrock', 'gypsum', 'taping', 'mudding'],
        'Roofing': ['roof', 'roofing', 'shingle', 'shingles', 'flashing'],
        'Masonry': ['brick', 'masonry', 'block', 'stone', 'mortar'],
        'Painting': ['paint', 'painting', 'primer', 'coating'],
        'Flooring': ['floor', 'flooring', 'tile', 'carpet', 'hardwood'],
    }
    
    detected_trade = ''
    for trade, keywords in trade_keywords.items():
        if any(keyword in text_lower for keyword in keywords):
            detected_trade = trade
            break
    
    # Location detection with patterns
    location_patterns = [
        r'floor\s*(\d+)',
        r'(\d+)(?:st|nd|rd|th)\s*floor',
        r'level\s*(\d+)',
        r'(basement|ground floor|roof|rooftop|exterior|interior)',
        r'(building\s*[a-z]|unit\s*\d+)',
        r'(north|south|east|west)\s*(side|wing|section)',
    ]
    
    detected_location = ''
    for pattern in location_patterns:
        match = re.search(pattern, text_lower)
        if match:
            detected_location = match.group(0).title()
            break
    
    # Delay detection
    delay_keywords = ['delay', 'delayed', 'behind', 'late', 'waiting', 'postpone', 'reschedule', 'rain', 'weather', 'storm']
    is_delay = any(keyword in text_lower for keyword in delay_keywords)
    
    # Delay reason extraction
    delay_reason = ''
    if is_delay:
        reason_patterns = {
            'rain': r'(rain|raining|rainy|rainfall)',
            'weather': r'(weather|storm|wind|snow)',
            'equipment': r'(equipment|machine|tool|delivery)',
            'material': r'(material|supply|supplies)',
            'inspection': r'(inspection|permit|approval)',
            'labor': r'(crew|worker|staff|manpower)',
        }
        
        for reason, pattern in reason_patterns.items():
            if re.search(pattern, text_lower):
                delay_reason = f"{reason.title()} related delay"
                break
        
        if not delay_reason:
            delay_reason = "Schedule delay"
    
    # Generate summary
    if is_delay:
        summary = f"{detected_trade or 'Work'} delayed. {delay_reason}"
    elif any(word in text_lower for word in ['complete', 'done', 'finished']):
        summary = f"{detected_trade or 'Work'} completed at {detected_location or 'site'}"
    else:
        summary = message_text[:100]
    
    return {
        "trade": detected_trade,
        "location": detected_location,
        "is_delay": is_delay,
        "delay_reason": delay_reason,
        "summary": summary
    }


