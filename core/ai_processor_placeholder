def suggest_related_documents(message_text, available_docs):
    """
    Suggest relevant documents based on keyword matching
    """
    if not available_docs:
        return []
    
    text_lower = message_text.lower()
    
    # Extract keywords from message
    keywords = []
    
    # Add trade keywords
    trade_keywords = ['electrical', 'plumbing', 'hvac', 'concrete', 'framing', 'roof']
    keywords.extend([k for k in trade_keywords if k in text_lower])
    
    # Add document type keywords
    doc_keywords = ['permit', 'plan', 'drawing', 'contract', 'invoice', 'schedule', 'spec', 'submittal']
    keywords.extend([k for k in doc_keywords if k in text_lower])
    
    if not keywords:
        return []
    
    # Score each document based on keyword matches
    scored_docs = []
    for doc in available_docs:
        doc_name_lower = doc['name'].lower()
        score = sum(1 for keyword in keywords if keyword in doc_name_lower)
        if score > 0:
            scored_docs.append((score, doc))
    
    # Sort by score and return top 3
    scored_docs.sort(reverse=True, key=lambda x: x[0])
    return [doc for score, doc in scored_docs[:3]]


def generate_dashboard_summary(recent_messages, sheet_data):
    """
    Create executive summary using pattern analysis
